{
  "name": "dashlint",
  "version": "0.1.0",
  "description": "Checks that your analytics SDK calls match what your dashboards, alerts and insights actually need.",
  "license": "MIT",
  "author": "Aman Gupta (https://github.com/guptaaman678)",
  "type": "module",
  "bin": {
    "dashlint": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "!dist/action.mjs",
    "descriptors",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "lint": "eslint . && prettier --check .",
    "check:formats": "node scripts/build.mjs && node scripts/check-formats.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "sync:action": "node scripts/sync-action.mjs"
  },
  "dependencies": {
    "typescript": "~6.0.3",
    "yaml": "2.9.1",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
